<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Built for a D-pad remote: no touch screen needed. Leanback is optional so emulators/dev boxes can run it too. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Everything this app asks for. No storage, no location, no accounts, no "all packages". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility limited to exactly the catalog's package ids (checked by a unit test). -->
    <queries>
        <package android:name="com.nuvio.tv" />
        <package android:name="com.myiptvonline.implayer" />
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
    </queries>

    <application
        android:name=".TvEssentialsApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvEssentials"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system installer, through our own PendingIntent, can reach this. -->
        <receiver
            android:name=".platform.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
