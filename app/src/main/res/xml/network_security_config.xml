<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust store only. Downloads are additionally restricted to reviewed hosts in code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
